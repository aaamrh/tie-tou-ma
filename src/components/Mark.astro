---
interface Props {
  type?: 'underline' | 'circle' | 'highlight' | 'box' | 'strike-through' | 'crossed-off' | 'bracket' | 'wavy' | 'straight';
  color?: string;
}

const defaultColors: Record<NonNullable<Props['type']>, string> = {
  underline: '#2b9e68',
  circle: '#e9435a',
  highlight: '#ffe66d',
  box: '#2787e5',
  'strike-through': '#858585',
  'crossed-off': '#858585',
  bracket: '#e879b5',
  wavy: '#7f00ff',
  straight: '#2b9e68',
};

const { type = 'underline', color } = Astro.props;
const lightColor = color ?? defaultColors[type];
const darkColor = color ?? (type === 'wavy' ? '#b48aff' : defaultColors[type]);
const handDrawn = ['underline', 'circle', 'highlight', 'box', 'strike-through', 'crossed-off', 'bracket'].includes(type);
---
<span
  class:list={['mark', `mark--${type}`]}
  style={{ '--mark-color-light': lightColor, '--mark-color-dark': darkColor }}
  data-annotation={handDrawn ? type : undefined}
  data-color={handDrawn ? lightColor : undefined}
><slot /></span>
