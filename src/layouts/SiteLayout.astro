---
import '@fontsource/bree-serif/latin-400.css';
import '@fontsource/bungee-shade/latin-400.css';
import '../styles/global.css';
import { site } from '../site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon.png`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳转到正文</a>
    <header class="site-header">
      <a class="site-title" href={import.meta.env.BASE_URL}>{site.title}</a>
      <p class="site-subtitle">{site.subtitle}</p>
      <hr class="header-line" />
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} {site.title}</span>
      <a href={import.meta.env.BASE_URL}>文章</a>
    </footer>
  </body>
</html>
