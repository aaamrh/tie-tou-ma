---
import SiteLayout from '../layouts/SiteLayout.astro';
import PostList from '../components/PostList.astro';
import { getPosts, categoryUrl } from '../lib/posts';

const posts = await getPosts();
const categories = [...new Set(posts.map((post) => post.data.category))];
---
<SiteLayout>
  <h1 class="sr-only">文章</h1>
  <nav class="category-nav" aria-label="文章分类">
    <a href={import.meta.env.BASE_URL} aria-current="page">全部</a>
    {categories.map((category) => <a href={categoryUrl(category)}>{category}</a>)}
  </nav>
  <PostList posts={posts} />
</SiteLayout>
